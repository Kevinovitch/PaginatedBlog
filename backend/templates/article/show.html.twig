{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('article_index') }}">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ article.title }}</li>
            </ol>
        </nav>

        <article class="mb-5">
            <header class="mb-4">
                <h1 class="display-4">{{ article.title }}</h1>
                <div class="text-muted mb-3">
                    <small>
                        Published by {{ article.author.email }}
                        {% if article.tags|length > 0 %}
                            | Tags :
                            {% for tag in article.tags %}
                                <span class="badge bg-secondary">{{ tag.name }}</span>
                            {% endfor %}
                        {% endif %}
                    </small>
                </div>
            </header>

            <div class="article-content">
                {{ article.content|nl2br }}
            </div>

            <footer class="mt-4">
                <div class="d-flex gap-2">
                    <a href="{{ path('article_index') }}" class="btn btn-secondary">
                        Back to the list
                    </a>

                    {% if app.user and article.author == app.user %}
                        <a href="{{ path('article_edit', {id: article.id}) }}" class="btn btn-warning">
                            Edit
                        </a>
                        <form method="post" action="{{ path('article_delete', {id: article.id}) }}"
                              style="display: inline-block;"
                              onsubmit="return confirm('Are you sure you want to delete this article?');">
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    {% endif %}
                </div>
            </footer>
        </article>
    </div>
{% endblock %}