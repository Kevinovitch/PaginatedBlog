{% extends 'base.html.twig' %}

{% block title %}Profile - {{ user.email }}{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="card">
            <div class="card-header">
                <h1>Profile</h1>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <h5>Email</h5>
                    <p>{{ user.email }}</p>

                    <h5>Registered since</h5>
                    <p>{{ user.createdAt|date('d/m/Y') }}</p>

                    <h5>Author of {{ articlesCount }} article{% if articlesCount != 1 %}s{% endif %}</h5>
                </div>

                {% if articles|length > 0 %}
                    <div class="mb-4">
                        <h5>Articles</h5>
                        <ul class="list-group">
                            {% for article in articles %}
                                <li class="list-group-item">
                                    <a href="{{ path('article_show', {'slug': article.slug}) }}">
                                        {{ article.title }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                <div class="d-flex gap-2">
                    <a href="{{ path('article_index') }}" class="btn btn-secondary">Back to the list</a>
                    <a href="{{ path('app_logout') }}" class="btn btn-danger">Logout</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}